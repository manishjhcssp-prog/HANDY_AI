# ==============================================================================
# JARVIS AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit your actual .env file to version control.
# Multiple keys per provider are supported by indexing with _1, _2, _3...
# ==============================================================================

# Target ₹0 ongoing API cost. Set to true to enforce free-only endpoints.
JARVIS_FREE_ONLY_MODE=true

# 1. OpenRouter Keys (Primary Provider - free models router openrouter/free)
OPENROUTER_API_KEY_1=your_openrouter_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_key_2_here
OPENROUTER_DEFAULT_MODEL=openrouter/free

# 2. Groq Keys (Fast-response alternative - free tier)
GROQ_API_KEY_1=your_groq_key_1_here
GROQ_API_KEY_2=your_groq_key_2_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# 3. Google Gemini Keys (Reasoning & vision alternative - free tier)
GEMINI_API_KEY_1=your_gemini_key_1_here
GEMINI_API_KEY_2=your_gemini_key_2_here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# 4. Local Ollama (Offline fallback - 100% free & private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

# 5. Sarvam AI Keys (Indian languages & speech tasks)
SARVAM_API_KEY_1=your_sarvam_key_1_here
SARVAM_API_KEY_2=your_sarvam_key_2_here
SARVAM_DEFAULT_MODEL=sarvam-105b-conversations

# System Settings
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO
